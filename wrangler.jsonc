{
  "$schema": "https://unpkg.com/wrangler@4.114.0/config-schema.json",
  "name": "jakew-me",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-05-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
