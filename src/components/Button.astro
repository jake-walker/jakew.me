---
import IconArrowRight from "~icons/tabler/arrow-right";

interface Props {
  class?: string;
  link: string;
  icon?: string;
}

const { link, icon, class: className } = Astro.props;

const iconComponents = {
  "tabler:arrow-right": IconArrowRight,
};
const ButtonIcon = icon
  ? iconComponents[icon as keyof typeof iconComponents]
  : undefined;
---

<a
  href={link}
  class:list={[
    "bg-primary-500 hover:bg-primary-300 text-white hover:text-primary-900 py-4 px-6 text-lg rounded-full",
    ...(className ?? []),
  ]}
>
  {ButtonIcon && <ButtonIcon class="inline size-6" />}
  <slot />
</a>
