---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { DateTime } from "luxon";
import { type Project } from "../lib/types";
import IconBox from "~icons/tabler/box";
import IconBrandApple from "~icons/tabler/brand-apple";
import IconBrandGithub from "~icons/tabler/brand-github";
import IconExternalLink from "~icons/tabler/external-link";
import IconGitMerge from "~icons/tabler/git-merge";
import IconLink from "~icons/tabler/link";
import IconPackageImport from "~icons/tabler/package-import";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const iconComponents = {
  "tabler:brand-apple": IconBrandApple,
  "tabler:brand-github": IconBrandGithub,
  "tabler:external-link": IconExternalLink,
  "tabler:git-merge": IconGitMerge,
  "tabler:link": IconLink,
  "tabler:package-import": IconPackageImport,
};
---

<div>
  <div
    class:list={{
      "bg-primary-100 text-primary-900 dark:bg-primary-950 dark:text-primary-300":
        !project.featured,
      "bg-primary-950 text-primary-300 dark:bg-primary-500 dark:text-primary-200 text-lg":
        project.featured,
    }}
    class="text-start rounded-xl p-6"
  >
    <div class="flex flex-col sm:flex-row gap-4">
      <div>
        <div
          class:list={{
            "rounded-full": !project.iconUrl,
            "bg-primary-300 dark:bg-primary-500":
              !project.iconUrl && !project.featured,
            "bg-primary-300 dark:bg-primary-300 text-primary-600":
              !project.iconUrl && project.featured,
            "hidden sm:block": !project.featured,
          }}
          class="block size-18"
        >
          {
            project.iconUrl ? (
              <Image
                src={project.iconUrl}
                alt={`${project.name} icon`}
                inferSize={true}
              />
            ) : (
              <IconBox class="block size-12 my-auto mx-auto h-full" />
            )
          }
        </div>
      </div>
      <div>
        <h5
          class:list={{
            "text-primary-950 dark:text-primary-100 text-xl": !project.featured,
            "text-primary-100 dark:text-primary-50 text-2xl": project.featured,
          }}
          class="font-medium underline-offset-2 transition-all mb-1"
        >
          {project.name}
          {
            project.badgeText && (
              <span
                class:list={{
                  "bg-primary-900 text-primary-50": !project.featured,
                  "bg-primary-600 dark:bg-primary-400 text-primary-50":
                    project.featured,
                }}
                class="text-xs rounded-full py-1 px-3 my-auto ms-2"
              >
                {project.badgeText}
              </span>
            )
          }
        </h5>
        <p class="mb-1">{project.description}</p>
        {
          project.language && (
            <p
              class="mb-2 italic"
              class:list={[project.featured ? "text-sm" : "text-xs"]}
            >
              Language: {project.language}
            </p>
          )
        }
      </div>
    </div>
    <div class="flex flex-col sm:flex-row items-end justify-end gap-4 mt-2">
      {
        project.links.map((link) => {
          const LinkIcon =
            iconComponents[
              (link.icon ??
                "tabler:external-link") as keyof typeof iconComponents
            ];

          return (
            <a
              href={link.url}
              class:list={{
                "bg-primary-300 text-primary-950 hover:bg-primary-400 dark:hover:bg-primary-200":
                  !project.featured,
                "text-base bg-primary-800 text-primary-100 hover:bg-primary-700 dark:bg-primary-900 dark:text-primary-100 dark:hover:bg-primary-800":
                  project.featured,
              }}
              class="rounded-md py-1 px-2"
            >
              <LinkIcon class="inline me-1" />
              {link.title}
            </a>
          );
        })
      }
    </div>
  </div>
</div>
